parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # generated by Symfony in debug mode
        - config/reference.php
    ignoreErrors:
        # Doctrine assigns the generated id by reflection, so ?int is correct.
        -
            identifier: property.unusedType
            path: src/Entity/*
