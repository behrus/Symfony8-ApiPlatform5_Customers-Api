{
  "permissions": {
    "allow": [
      "Bash(docker compose exec web php bin/phpunit*)",
      "Bash(docker compose exec web vendor/bin/phpstan*)",
      "Bash(docker compose exec web php bin/console debug:*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  }
}
